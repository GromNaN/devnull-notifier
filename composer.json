{
    "name": "gromnan/devnull-notifier",
    "type": "symfony-notifier-bridge",
    "description": "Symfony dev-null.sh Notifier Bridge",
    "keywords": ["notifier", "dev-null", "devnull"],
    "license": "MIT",
    "authors": [
        {
            "name": "Jérôme Tamarelle",
            "email": "jerome.tamarelle@mongodb.com"
        }
    ],
    "require": {
        "php": ">=8.2",
        "phpseclib/phpseclib": "^4.0",
        "symfony/http-client": "^7.4|^8.0",
        "symfony/notifier": "^7.4|^8.0",
        "symfony/polyfill-mbstring": "^1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "symfony/config": "^7.4|^8.0",
        "symfony/dependency-injection": "^7.4|^8.0",
        "symfony/event-dispatcher": "^7.4|^8.0",
        "symfony/http-kernel": "^7.4|^8.0"
    },
    "autoload": {
        "psr-4": { "GromNaN\\Notifier\\Bridge\\DevNull\\": "" },
        "exclude-from-classmap": [
            "/Tests/"
        ]
    },
    "minimum-stability": "stable"
}
